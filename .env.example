# Copy this to .env and fill in your values
# .env is gitignored — never commit real credentials

# Postgres
POSTGRES_USER=health
POSTGRES_PASSWORD=changeme
POSTGRES_DB=health_pipeline

# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=  # generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://health:changeme@postgres:5432/health_pipeline
AIRFLOW__WEBSERVER__SECRET_KEY=  # generate with: openssl rand -hex 32

# Whoop API
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_USERNAME=
WHOOP_PASSWORD=

# Withings API
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_ACCESS_TOKEN=
WITHINGS_REFRESH_TOKEN=

# MyFitnessPal
MFP_USERNAME=
MFP_PASSWORD=

# File paths (inside container)
RAW_DATA_PATH=/opt/airflow/data/raw
