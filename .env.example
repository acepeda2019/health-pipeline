# Copy this to .env and fill in your values
# .env is gitignored — never commit real credentials

# Airflow
AIRFLOW__API__SECRET_KEY= # generate with: openssl rand -hex 32
AIRFLOW__API_AUTH__JWT_SECRET= # generate with: openssl rand -hex 32
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY= # generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS=admin:admin
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://health:changeme@postgres:5432/health_pipeline

# MyFitnessPal
MFP_PASSWORD=
MFP_USERNAME=

# Postgres
POSTGRES_DB=health_pipeline
POSTGRES_PASSWORD=changeme
POSTGRES_USER=health

# File paths (inside container)
RAW_DATA_PATH=/opt/airflow/data/raw

# Whoop API (OAuth2)
WHOOP_ACCESS_TOKEN=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REFRESH_TOKEN=

# Withings API
WITHINGS_ACCESS_TOKEN=
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REFRESH_TOKEN=
